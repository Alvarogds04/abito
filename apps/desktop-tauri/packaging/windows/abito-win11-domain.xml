<?xml version='1.0' encoding='UTF-8'?>
<!--
  Abito island Windows-port test VM (unattended install).
  Defined by vm.sh create through `virsh define`; started with `virsh start`.

  Written by hand instead of generated by virt-install because this
  virt-install + libvirt pair mishandles the pieces Windows 11 needs here:
    - `tpm emulate` emits <backend type="emulate">, which libvirt rejects
      (it wants type="emulator");
    - two `cdrom` arguments make `print-xml` emit two complete <domain>
      documents, which libvirt cannot parse;
    - `console pty,target_type=isa-serial` emits a target type libvirt
      does not accept.

  In-box-driver choices, so nothing has to be installed to get the OS up:
  SATA (ahci) for the disk and e1000e for the network; virtio would need the
  virtio-win drivers on a third CD. No <address> elements: libvirt assigns
  them, which keeps this portable across q35 revisions.

  Media lives under /var/lib/libvirt/abito-vm (readable by libvirt-qemu);
  vm.sh keeps the answer CD there as abito-win11-cd.iso.
-->
<domain type='kvm'>
  <name>abito-win11</name>
  <memory unit='GiB'>8</memory>
  <vcpu placement='static'>4</vcpu>
  <os firmware='efi'>
    <type arch='x86_64' machine='q35'>hvm</type>

  </os>
  <features>
    <acpi/>
    <apic/>
    <hyperv mode='custom'>
      <relaxed state='on'/>
      <vapic state='on'/>
      <spinlocks state='on' retries='8191'/>
    </hyperv>
  </features>
  <cpu mode='host-passthrough' check='partial'/>
  <clock offset='localtime'>
    <timer name='rtc' tickpolicy='catchup'/>
    <timer name='pit' tickpolicy='delay'/>
    <timer name='hpet' present='no'/>
    <timer name='hypervclock' present='yes'/>
  </clock>
  <on_poweroff>destroy</on_poweroff>
  <on_reboot>restart</on_reboot>
  <on_crash>destroy</on_crash>
  <devices>
    <emulator>/usr/bin/qemu-system-x86_64</emulator>
    <disk type='file' device='disk'>
      <driver name='qemu' type='qcow2' cache='none' io='native'/>
      <source file='/var/lib/libvirt/images/abito-win11.qcow2'/>
      <target dev='sda' bus='sata'/>
      <boot order='3'/>
    </disk>
    <disk type='file' device='cdrom'>
      <driver name='qemu' type='raw'/>
      <source file='/var/lib/libvirt/abito-vm/abito-win11-cd.iso'/>
      <target dev='sdb' bus='sata'/>
      <readonly/>
      <boot order='2'/>
    </disk>
    <disk type='file' device='cdrom'>
      <driver name='qemu' type='raw'/>
      <source file='/var/lib/libvirt/abito-vm/iso/Win11_25H2_noprompt.iso'/>
      <target dev='sdc' bus='sata'/>
      <readonly/>
      <boot order='1'/>
    </disk>
    <controller type='sata' index='0'/>
    <controller type='usb' model='qemu-xhci'/>
    <controller type='virtio-serial'/>
    <interface type='network'>
      <source network='default'/>
      <model type='e1000e'/>
    </interface>
    <serial type='pty'>
      <target type='isa-serial' port='0'/>
    </serial>

    <input type='keyboard' bus='usb'/>
    <input type='tablet' bus='usb'/>
    <input type='mouse' bus='ps2'/>
    <video>
      <model type='vga' vram='16384' heads='1' primary='yes'/>
    </video>
    <graphics type='vnc' port='-1' autoport='yes' listen='127.0.0.1'/>
    <sound model='ich9'/>
    <rng model='virtio'>
      <backend model='random'>/dev/random</backend>
    </rng>
    <tpm model='tpm-crb'>
      <backend type='emulator'/>
    </tpm>
  </devices>
</domain>
